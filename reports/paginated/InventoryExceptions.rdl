<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <Description>Simulated inventory exceptions. Historical fulfilled sales proxy demand; all inventory inputs are hypothetical.</Description>
  <DataSources>
    <DataSource Name="InventoryModel">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://api.powerbi.com/;Initial Catalog=sobe_wowvirtualserver-SEMANTIC_MODEL_ID;Integrated Security=ClaimsToken</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <ReportParameters>
    <ReportParameter Name="Scenario">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>L7_R7_I14</Value>
        </Values>
      </DefaultValue>
      <Prompt>Scenario</Prompt>
      <ValidValues>
        <ParameterValues>
          <ParameterValue>
            <Value>L3_R7_I7</Value>
          </ParameterValue>
          <ParameterValue>
            <Value>L3_R7_I14</Value>
          </ParameterValue>
          <ParameterValue>
            <Value>L3_R7_I28</Value>
          </ParameterValue>
          <ParameterValue>
            <Value>L7_R7_I7</Value>
          </ParameterValue>
          <ParameterValue>
            <Value>L7_R7_I14</Value>
          </ParameterValue>
          <ParameterValue>
            <Value>L7_R7_I28</Value>
          </ParameterValue>
          <ParameterValue>
            <Value>L14_R7_I7</Value>
          </ParameterValue>
          <ParameterValue>
            <Value>L14_R7_I14</Value>
          </ParameterValue>
          <ParameterValue>
            <Value>L14_R7_I28</Value>
          </ParameterValue>
        </ParameterValues>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="Policy">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>order_up_to</Value>
        </Values>
      </DefaultValue>
      <Prompt>Policy</Prompt>
      <ValidValues>
        <ParameterValues>
          <ParameterValue>
            <Value>fixed_cover</Value>
          </ParameterValue>
          <ParameterValue>
            <Value>order_up_to</Value>
          </ParameterValue>
        </ParameterValues>
      </ValidValues>
    </ReportParameter>
  </ReportParameters>
  <DataSets>
    <DataSet Name="Exceptions">
      <Query>
        <DataSourceName>InventoryModel</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="Scenario">
            <Value>=Parameters!Scenario.Value</Value>
          </QueryParameter>
          <QueryParameter Name="Policy">
            <Value>=Parameters!Policy.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EVALUATE
VAR Products = SUMMARIZECOLUMNS(
    Product[item_id],
    TREATAS({@Scenario}, Scenario[scenario_id]),
    TREATAS({@Policy}, Policy[policy]),
    "Demand", [Demand proxy units], "Unmet", [Unmet proxy units],
    "Fill", [Unit fill rate], "Stock", [Average closing inventory])
RETURN SELECTCOLUMNS(FILTER(Products, [Unmet] &gt; 0),
    "Item", Product[item_id], "Demand", [Demand], "Unmet", [Unmet], "Fill", [Fill], "Stock", [Stock])
ORDER BY [Unmet] DESC, [Item] ASC</CommandText>
      </Query>
      <Fields>
        <Field Name="Item">
          <DataField>[Item]</DataField>
        </Field>
        <Field Name="Demand">
          <DataField>[Demand]</DataField>
        </Field>
        <Field Name="Unmet">
          <DataField>[Unmet]</DataField>
        </Field>
        <Field Name="Fill">
          <DataField>[Fill]</DataField>
        </Field>
        <Field Name="Stock">
          <DataField>[Stock]</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Title">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Inventory exception report</Value>
                    <Style>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Style>
              <PaddingLeft>4pt</PaddingLeft>
              <PaddingTop>3pt</PaddingTop>
            </Style>
